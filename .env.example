# ------------------------------------------------------------------------------
# System Ingestion & Storage Configuration
# ------------------------------------------------------------------------------

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=betting_lakehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/betting_lakehouse

# MinIO (S3-Compatible Object Store) Configuration
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=supersecretpassword
MINIO_ENDPOINT=localhost:9005
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_WAREHOUSE=warehouse

# Nessie REST Catalog Configuration
NESSIE_URI=http://localhost:19120/api/v1
NESSIE_WAREHOUSE=s3a://warehouse/

# Prometheus Monitoring Configuration
PROMETHEUS_PORT=8001

# Spark Master Configuration
SPARK_MASTER=local[*]
SPARK_LOCAL_IP=127.0.0.1
